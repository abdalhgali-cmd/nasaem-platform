{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableAutoMode": "disable",
    "allow": [
      "mcp__codex__codex_review_code",
      "mcp__codex__codex_review_plan",
      "mcp__codex__codex_explain_code",
      "mcp__codex__codex_plan_perf",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push -u origin claude/*)",
      "Bash(git push -u origin codex/*)",
      "Bash(git push origin claude/*)",
      "Bash(git push origin codex/*)",
      "Bash(gh pr create --draft *)",
      "Bash(bash .codex/scripts/tests/test-codex-scripts.sh)",
      "Bash(bash .codex/scripts/codex-review.sh *)"
    ],
    "ask": [
      "mcp__codex__codex_query",
      "Bash(bash .codex/scripts/codex-implement.sh *)",
      "Bash(git push *main*)",
      "Bash(git push *:*)",
      "Bash(git push *+*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--delete*)",
      "Bash(git push * -d *)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--all*)",
      "Bash(git push *--tags*)",
      "Bash(gh pr merge *)",
      "Bash(gh pr ready *)",
      "Bash(gh secret *)",
      "Bash(gh workflow *)",
      "Bash(railway *)",
      "Bash(vercel *)",
      "mcp__github__merge_pull_request",
      "mcp__Railway"
    ],
    "deny": [
      "mcp__codex__codex_implement",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git checkout -f*)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git branch -D *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune*)"
    ]
  }
}
