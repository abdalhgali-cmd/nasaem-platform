# Base URL of the staff back-office API (see ../backend), including the
# /api prefix. The contact form posts here directly from the browser.
#
# Vercel environments must be isolated:
# - Production -> Production Railway API
# - Preview -> dedicated Staging Railway API (never Production)
#
# api-url.ts fails closed on Vercel Preview if this still points at the known
# Production Railway host, including during server-side rendering.
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# Railway: the production website's own Railway host name(s), comma-separated,
# so the browser may call the production API from there (src/lib/api-url.ts).
# Set on the production website service only.
# NEXT_PUBLIC_PRODUCTION_WEB_HOSTS=nasaem-website-production.up.railway.app
