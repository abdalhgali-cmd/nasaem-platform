NODE_ENV=test

# Point this at a disposable database — the test suite creates and reads
# real rows against it. Never point this at a database with real data.
DATABASE_URL="postgresql://postgres:password@localhost:5432/nasaem_platform_test?schema=public"

JWT_SECRET="test_only_secret_do_not_use_in_production"
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Tests log in as this seeded account (see README's Testing section for the
# required migrate/seed steps before running `npm test`).
SEED_ADMIN_PASSWORD="Test@12345"
