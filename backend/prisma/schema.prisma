generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum OrderStatus {
  NEW
  UNDER_REVIEW
  WAITING_DOCUMENTS
  PAYMENT_PENDING
  PROCESSING
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum DocumentType {
  PASSPORT
  PHOTO
  VISA
  TICKET
  RECEIPT
  OTHER
}

enum OfferStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Tracks the manual bank-transfer flow on a ContactRequest (there is no live
// payment gateway): AWAITING_TRANSFER once a request with a price is
// created, UNDER_REVIEW once the customer uploads a transfer receipt, and
// CONFIRMED once staff verify the transfer actually landed. Requests that
// never carry a price (every service except a priced Umrah package) stay
// NOT_REQUIRED forever.
enum ContactRequestPaymentStatus {
  NOT_REQUIRED
  AWAITING_TRANSFER
  UNDER_REVIEW
  CONFIRMED
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String   @unique
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  User[]
  orders Order[]
}

model CompanyProfile {
  id          String   @id @default(cuid())
  name        String
  legalName   String?
  logoUrl     String?
  phone       String?
  whatsapp    String?
  email       String?
  address     String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Currency {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  symbol     String
  rateToSAR  Decimal  @db.Decimal(18, 6)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Supplier {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  type       String
  phone      String?
  email      String?
  notes      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id              String     @id @default(cuid())
  employeeNo      String     @unique
  fullName        String
  email           String     @unique
  phone           String?    @unique
  passwordHash    String
  role            UserRole   @default(EMPLOYEE)
  status          UserStatus @default(ACTIVE)
  branchId        String?
  lastLogin       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  branch              Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedOrders      Order[]                @relation("AssignedOrders")
  uploadedDocuments   Document[]             @relation("UploadedDocuments")
  notes               Note[]
  activityLogs        ActivityLog[]
  notifications       Notification[]         @relation("UserNotifications")
  statusChangedLogs   OrderStatusHistory[]   @relation("StatusChangedBy")

  @@index([role])
  @@index([status])
  @@index([branchId])
}

model Customer {
  id            String    @id @default(cuid())
  customerNo    String    @unique
  fullName      String
  passportNo    String    @unique
  nationality   String
  birthDate     DateTime?
  gender        Gender?
  phone         String?
  email         String?
  country       String?
  city          String?
  address       String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders     Order[]
  documents  Document[]

  @@index([customerNo])
  @@index([passportNo])
  @@index([phone])
  @@index([email])
}

model Service {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  category    String
  description String?
  basePrice   Decimal     @db.Decimal(12, 2)
  currency    String      @default("SAR")
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  orderItems  OrderItem[]
  workflows   Workflow[]
  visaTypes   VisaType[]

  @@index([category])
  @@index([active])
}

model VisaType {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  country     String
  description String?
  basePrice   Decimal   @db.Decimal(12, 2)
  currency    String    @default("SAR")
  active      Boolean   @default(true)
  serviceId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([country])
  @@index([active])
}

model Workflow {
  id          String    @id @default(cuid())
  serviceId   String
  stepNo      Int
  title       String
  description String?
  required    Boolean   @default(true)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, stepNo])
  @@index([serviceId])
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  customerId      String
  assignedUserId  String?
  branchId        String?
  status          OrderStatus    @default(NEW)
  paymentStatus   PaymentStatus  @default(UNPAID)
  priority        String         @default("NORMAL")
  totalAmount     Decimal        @db.Decimal(12, 2)
  currency       String         @default("SAR")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedUser   User?                @relation("AssignedOrders", fields: [assignedUserId], references: [id], onDelete: SetNull)
  branch         Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  documents      Document[]
  payments       Payment[]
  notes          Note[]
  history        OrderStatusHistory[]
  notifications  Notification[]

  @@index([customerId])
  @@index([assignedUserId])
  @@index([branchId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id          String    @id @default(cuid())
  orderId     String
  serviceId   String
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(12, 2)
  discount    Decimal   @db.Decimal(12, 2) @default(0)
  total       Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([serviceId])
}

model Document {
  id            String       @id @default(cuid())
  orderId       String
  customerId    String
  uploadedById  String
  type          DocumentType
  fileName      String
  storagePath   String
  mimeType      String?
  sizeBytes     Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uploadedBy  User    @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([customerId])
  @@index([uploadedById])
  @@index([type])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("SAR")
  paymentMethod   String
  referenceNumber String?
  status          PaymentStatus @default(UNPAID)
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model Note {
  id         String    @id @default(cuid())
  orderId    String
  userId     String
  note       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([userId])
}

model OrderStatusHistory {
  id              String       @id @default(cuid())
  orderId         String
  oldStatus       OrderStatus
  newStatus       OrderStatus
  changedByUserId String
  notes           String?
  changedAt       DateTime     @default(now())

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User @relation("StatusChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([changedByUserId])
}

model Notification {
  id        String    @id @default(cuid())
  title     String
  message   String
  type      String
  userId    String?
  orderId   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User?  @relation("UserNotifications", fields: [userId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([type])
}

model Offer {
  id          String      @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  price       Decimal     @db.Decimal(12, 2)
  currency    String      @default("SAR")
  startDate   DateTime?
  endDate     DateTime?
  status      OfferStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
}

model ActivityLog {
  id         String    @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model Setting {
  id         String   @id @default(cuid())
  key        String   @unique
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Used to generate sequential human-readable numbers (order/customer/employee)
// via an atomic single-statement upsert, instead of count()-based generation
// which is subject to race conditions under concurrent requests.
model Counter {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// One row per known branding slot (see site-assets.constants.js for the
// fixed list of allowed keys) — the currently-live file for that slot.
// Uploading again replaces the row (and the old file on disk) rather than
// versioning, since only the current asset is ever served.
model SiteAsset {
  id          String   @id @default(cuid())
  key         String   @unique
  fileName    String
  storagePath String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ContactRequestStatus {
  NEW
  CONTACTED
  CLOSED
}

// Submissions from the public marketing site's contact form (unauthenticated
// endpoint) — reviewed and actioned by staff, distinct from Customer/Order
// which represent an already-onboarded client with a real booking.
model ContactRequest {
  id        String               @id @default(cuid())
  name      String
  phone     String
  email     String?
  service   String?
  message   String
  // Structured per-service fields submitted from the service-specific
  // request forms on the marketing site (e.g. Umrah package type + travel
  // date + pilgrim count, or flight from/to/dates/cabin class). A flat
  // string-to-string map — free-text contact-form submissions simply omit
  // it, so it stays optional rather than becoming a second required input.
  details   Json?
  status    ContactRequestStatus @default(NEW)

  // Human-friendly tracking code (e.g. "NH-2026-00042") handed to the
  // customer immediately on submission so they can follow up by phone/
  // WhatsApp without knowing their internal cuid `id`.
  referenceNumber String? @unique

  // Manual bank-transfer flow — only populated for requests that carry a
  // known price (currently: priced Umrah packages). See
  // ContactRequestPaymentStatus for the state machine.
  currency           String?
  paymentAmount      Decimal?                     @db.Decimal(12, 2)
  paymentStatus      ContactRequestPaymentStatus  @default(NOT_REQUIRED)
  // DEPRECATED — superseded by the `documents` relation below, which
  // carries a per-file review status these flat arrays can't. Kept
  // (unused by any application code as of this migration) as a frozen
  // safety-net snapshot for one deploy cycle; a follow-up migration drops
  // these three columns once the backfill into ContactRequestDocument is
  // verified in production. Do not read or write these anymore.
  passportImagePaths      String[]                    @default([])
  guarantorIdImagePaths   String[]                    @default([])
  additionalDocumentPaths String[]                    @default([])
  paymentReceiptPath      String?

  // A staff-proposed price the customer hasn't approved yet — see Invoice.
  // paymentStatus stays NOT_REQUIRED until they do; only approval starts
  // the AWAITING_TRANSFER bank-transfer flow above.
  invoice Invoice?

  // One row per uploaded file (passport photo, guarantor Iqama photo, or
  // free-form additional document), each with its own review status —
  // replaces the three deprecated array columns above, which couldn't
  // carry per-file state (e.g. "this one needs to be re-uploaded").
  documents ContactRequestDocument[]

  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus])
}

enum ContactRequestDocumentType {
  PASSPORT
  GUARANTOR_ID
  ADDITIONAL
}

enum ContactRequestDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// A single customer-uploaded file for a ContactRequest, with its own
// staff-reviewable status. Uploading never replaces an existing row —
// a re-upload after a rejection adds a new row (the rejected one stays,
// for an audit trail) rather than silently discarding sibling documents.
model ContactRequestDocument {
  id               String                        @id @default(cuid())
  contactRequestId String
  type             ContactRequestDocumentType
  storagePath      String
  status           ContactRequestDocumentStatus  @default(PENDING)
  rejectionReason  String?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  contactRequest ContactRequest @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)

  @@index([contactRequestId])
  @@index([contactRequestId, type])
  @@index([status])
}

enum InvoiceStatus {
  PENDING_APPROVAL
  APPROVED
}

// A staff-proposed price for a ContactRequest with no catalog price
// (everything except a priced Umrah package, which prices itself
// automatically — see resolvePayment()). One per request (no revision
// history): staff editing the amount before the customer acts just updates
// this same row. Approving it is what actually starts the ContactRequest's
// AWAITING_TRANSFER bank-transfer flow — this table only ever gates that
// one transition, so it needs no PAID/CANCELLED states of its own.
model Invoice {
  id               String        @id @default(cuid())
  invoiceNumber    String        @unique
  contactRequestId String        @unique
  currency         String
  amount           Decimal       @db.Decimal(12, 2)
  status           InvoiceStatus @default(PENDING_APPROVAL)
  approvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  contactRequest ContactRequest @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
}

// One-time WhatsApp login codes for the customer-facing request-tracking
// portal (see customer-auth module). Deliberately has no relation to User
// or Customer — its identity IS the phone number, which is what keeps a
// customer session token structurally distinct from a staff one (no `sub`
// to satisfy requireAuth's staff-shaped payload check).
model CustomerLoginCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@index([expiresAt])
}
