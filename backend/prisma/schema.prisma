generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum OrderStatus {
  NEW
  UNDER_REVIEW
  WAITING_DOCUMENTS
  PAYMENT_PENDING
  PROCESSING
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum DocumentType {
  PASSPORT
  PHOTO
  VISA
  TICKET
  RECEIPT
  OTHER
}

enum OfferStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Tracks the manual bank-transfer flow on a ContactRequest (there is no live
// payment gateway): AWAITING_TRANSFER once a request with a price is
// created, UNDER_REVIEW once the customer uploads a transfer receipt, and
// CONFIRMED once staff verify the transfer actually landed. Requests that
// never carry a price (every service except a priced Umrah package) stay
// NOT_REQUIRED forever.
// NOT_REQUIRED -> AWAITING_TRANSFER -> UNDER_REVIEW -> CONFIRMED is the
// normal path. REFUNDED is a terminal branch reachable only from CONFIRMED
// (see updatePaymentStatus's refund precondition) — once REFUNDED, no
// further paymentStatus transition is allowed.
enum ContactRequestPaymentStatus {
  NOT_REQUIRED
  AWAITING_TRANSFER
  UNDER_REVIEW
  CONFIRMED
  REFUNDED
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String   @unique
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  User[]
  orders Order[]
}

model CompanyProfile {
  id          String   @id @default(cuid())
  name        String
  legalName   String?
  logoUrl     String?
  phone       String?
  whatsapp    String?
  email       String?
  address     String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Currency {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  symbol     String
  rateToSAR  Decimal  @db.Decimal(18, 6)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Supplier {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  type       String
  phone      String?
  email      String?
  notes      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id              String     @id @default(cuid())
  employeeNo      String     @unique
  fullName        String
  email           String     @unique
  phone           String?    @unique
  passwordHash    String
  role            UserRole   @default(EMPLOYEE)
  status          UserStatus @default(ACTIVE)
  branchId        String?
  // NULL means "no department assigned" — an EMPLOYEE with no department
  // sees every ContactRequest (the safe default, matching pre-Phase-E
  // behavior for every existing employee). Ignored entirely for
  // SUPER_ADMIN/ADMIN/ACCOUNTANT — department scoping applies to EMPLOYEE
  // only. See assertContactRequestAccess in contact-requests.service.js.
  department      ContactRequestDepartment?
  lastLogin       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  branch              Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedOrders      Order[]                @relation("AssignedOrders")
  uploadedDocuments   Document[]             @relation("UploadedDocuments")
  notes               Note[]
  activityLogs        ActivityLog[]
  notifications       Notification[]         @relation("UserNotifications")
  statusChangedLogs   OrderStatusHistory[]   @relation("StatusChangedBy")
  executionStageLogs  ContactRequestExecutionHistory[] @relation("ExecutionStageChangedBy")
  passwordResetCodes  StaffPasswordResetCode[] @relation("StaffPasswordResets")

  @@index([role])
  @@index([status])
  @@index([branchId])
  @@index([department])
}

model Customer {
  id            String    @id @default(cuid())
  customerNo    String    @unique
  fullName      String
  passportNo    String    @unique
  nationality   String
  birthDate     DateTime?
  gender        Gender?
  phone         String?
  email         String?
  country       String?
  city          String?
  address       String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders     Order[]
  documents  Document[]

  @@index([customerNo])
  @@index([passportNo])
  @@index([phone])
  @@index([email])
}

model Service {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  category    String
  description String?
  basePrice   Decimal     @db.Decimal(12, 2)
  currency    String      @default("SAR")
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  orderItems  OrderItem[]
  workflows   Workflow[]
  visaTypes   VisaType[]

  @@index([category])
  @@index([active])
}

model VisaType {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  country     String
  description String?
  basePrice   Decimal   @db.Decimal(12, 2)
  currency    String    @default("SAR")
  active      Boolean   @default(true)
  serviceId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([country])
  @@index([active])
}

model Workflow {
  id          String    @id @default(cuid())
  serviceId   String
  stepNo      Int
  title       String
  description String?
  required    Boolean   @default(true)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, stepNo])
  @@index([serviceId])
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  customerId      String
  assignedUserId  String?
  branchId        String?
  status          OrderStatus    @default(NEW)
  paymentStatus   PaymentStatus  @default(UNPAID)
  priority        String         @default("NORMAL")
  totalAmount     Decimal        @db.Decimal(12, 2)
  currency       String         @default("SAR")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedUser   User?                @relation("AssignedOrders", fields: [assignedUserId], references: [id], onDelete: SetNull)
  branch         Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  documents      Document[]
  payments       Payment[]
  notes          Note[]
  history        OrderStatusHistory[]
  notifications  Notification[]

  @@index([customerId])
  @@index([assignedUserId])
  @@index([branchId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id          String    @id @default(cuid())
  orderId     String
  serviceId   String
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(12, 2)
  discount    Decimal   @db.Decimal(12, 2) @default(0)
  total       Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([serviceId])
}

model Document {
  id            String       @id @default(cuid())
  orderId       String
  customerId    String
  uploadedById  String
  type          DocumentType
  fileName      String
  storagePath   String
  mimeType      String?
  sizeBytes     Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uploadedBy  User    @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([customerId])
  @@index([uploadedById])
  @@index([type])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("SAR")
  paymentMethod   String
  referenceNumber String?
  status          PaymentStatus @default(UNPAID)
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model Note {
  id         String    @id @default(cuid())
  orderId    String
  userId     String
  note       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([userId])
}

model OrderStatusHistory {
  id              String       @id @default(cuid())
  orderId         String
  oldStatus       OrderStatus
  newStatus       OrderStatus
  changedByUserId String
  notes           String?
  changedAt       DateTime     @default(now())

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User @relation("StatusChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([changedByUserId])
}

model Notification {
  id        String    @id @default(cuid())
  title     String
  message   String
  type      String
  userId    String?
  orderId   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User?  @relation("UserNotifications", fields: [userId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([type])
}

model Offer {
  id          String      @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  price       Decimal     @db.Decimal(12, 2)
  currency    String      @default("SAR")
  startDate   DateTime?
  endDate     DateTime?
  status      OfferStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
}

model ActivityLog {
  id         String    @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model Setting {
  id         String   @id @default(cuid())
  key        String   @unique
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Used to generate sequential human-readable numbers (order/customer/employee)
// via an atomic single-statement upsert, instead of count()-based generation
// which is subject to race conditions under concurrent requests.
model Counter {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// One row per known branding slot (see site-assets.constants.js for the
// fixed list of allowed keys) — the currently-live file for that slot.
// Uploading again replaces the row (and the old file on disk) rather than
// versioning, since only the current asset is ever served.
model SiteAsset {
  id          String   @id @default(cuid())
  key         String   @unique
  fileName    String
  storagePath String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ContactRequestStatus {
  NEW
  CONTACTED
  CLOSED
}

// Submissions from the public marketing site's contact form (unauthenticated
// endpoint) — reviewed and actioned by staff, distinct from Customer/Order
// which represent an already-onboarded client with a real booking.
model ContactRequest {
  id        String               @id @default(cuid())
  name      String
  phone     String
  email     String?
  service   String?
  message   String
  // Structured per-service fields submitted from the service-specific
  // request forms on the marketing site (e.g. Umrah package type + travel
  // date + pilgrim count, or flight from/to/dates/cabin class). A flat
  // string-to-string map — free-text contact-form submissions simply omit
  // it, so it stays optional rather than becoming a second required input.
  details   Json?
  status    ContactRequestStatus @default(NEW)

  // Derived from `service` at creation time by
  // deriveContactRequestDepartment() (contact-request-department.js) — see
  // that file for the exact string->department table. NULL means the
  // free-text `service` string couldn't be mapped (e.g. "استفسار آخر", or
  // no service at all) — an unmapped request stays visible to every
  // EMPLOYEE regardless of their own department (see
  // assertContactRequestAccess in contact-requests.service.js), rather
  // than silently vanishing from everyone's queue.
  department ContactRequestDepartment?

  // Human-friendly tracking code (e.g. "NH-2026-00042") handed to the
  // customer immediately on submission so they can follow up by phone/
  // WhatsApp without knowing their internal cuid `id`.
  referenceNumber String? @unique

  // Manual bank-transfer flow — only populated for requests that carry a
  // known price (currently: priced Umrah packages). See
  // ContactRequestPaymentStatus for the state machine.
  currency           String?
  paymentAmount      Decimal?                     @db.Decimal(12, 2)
  paymentStatus      ContactRequestPaymentStatus  @default(NOT_REQUIRED)
  // When paymentStatus first became CONFIRMED — the only accurate anchor
  // for "money collected in this window" reporting (createdAt answers a
  // different question: "requests opened in this window"). Written once,
  // by updatePaymentStatus's first-confirmation branch; a redundant
  // re-PATCH of the same CONFIRMED value does not move it.
  paymentConfirmedAt DateTime?
  // When a CONFIRMED payment was reversed. Kept alongside (not instead of)
  // paymentConfirmedAt so a refunded request retains when it was
  // originally collected.
  refundedAt         DateTime?
  // DEPRECATED — superseded by the `documents` relation below, which
  // carries a per-file review status these flat arrays can't. Kept
  // (unused by any application code as of this migration) as a frozen
  // safety-net snapshot for one deploy cycle; a follow-up migration drops
  // these three columns once the backfill into ContactRequestDocument is
  // verified in production. Do not read or write these anymore.
  passportImagePaths      String[]                    @default([])
  guarantorIdImagePaths   String[]                    @default([])
  additionalDocumentPaths String[]                    @default([])
  paymentReceiptPath      String?

  // A staff-proposed price the customer hasn't approved yet — see Invoice.
  // paymentStatus stays NOT_REQUIRED until they do; only approval starts
  // the AWAITING_TRANSFER bank-transfer flow above.
  invoice Invoice?

  // Multiple staff-proposed priced alternatives (e.g. different airlines at
  // different prices) for services where more than one legitimate option
  // exists — see ContactRequestOffer. A request realistically uses either
  // `invoice` or `offers`, never both, but that isn't enforced at the DB
  // level.
  offers ContactRequestOffer[]

  // One row per uploaded file (passport photo, guarantor Iqama photo, or
  // free-form additional document), each with its own review status —
  // replaces the three deprecated array columns above, which couldn't
  // carry per-file state (e.g. "this one needs to be re-uploaded").
  documents ContactRequestDocument[]

  // What staff are actually *doing* with a request once it's paid for —
  // orthogonal to `status` (staff triage: NEW/CONTACTED/CLOSED) and to
  // `paymentStatus` (money). NULL until staff explicitly starts execution.
  // See ContactRequestExecutionStage and contact-request-execution.js for
  // which values are legal for a given department.
  executionStage   ContactRequestExecutionStage?
  executionHistory ContactRequestExecutionHistory[]

  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([department])
  @@index([executionStage])
  @@index([paymentConfirmedAt])
}

// The 5 staff departments a ContactRequest/User can be scoped to (see
// auth.middleware.js's requireAuth and contact-requests.service.js's
// assertContactRequestAccess). Deliberately shared by both models rather
// than two separate enums, since they're the same concept from two sides.
enum ContactRequestDepartment {
  VISAS
  FLIGHTS
  UMRAH
  HOTELS_PACKAGES
  FERRY
}

enum ContactRequestDocumentType {
  PASSPORT
  GUARANTOR_ID
  ADDITIONAL
  // Staff-authored deliverable (issued visa PDF, e-ticket, hotel voucher)
  // attached to the request and downloadable by the customer — unlike the
  // other three types, never customer-uploaded. See createFinalDocuments in
  // contact-requests.service.js.
  FINAL
}

enum ContactRequestDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// A single customer-uploaded file for a ContactRequest, with its own
// staff-reviewable status. Uploading never replaces an existing row —
// a re-upload after a rejection adds a new row (the rejected one stays,
// for an audit trail) rather than silently discarding sibling documents.
model ContactRequestDocument {
  id               String                        @id @default(cuid())
  contactRequestId String
  type             ContactRequestDocumentType
  storagePath      String
  status           ContactRequestDocumentStatus  @default(PENDING)
  rejectionReason  String?
  // Original upload filename. Only ever set for staff-uploaded FINAL
  // documents (the customer-upload paths don't collect it) — a customer
  // downloading their visa should get "visa-approval.pdf", not a generic
  // name built from storagePath's random suffix.
  fileName         String?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  contactRequest ContactRequest @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)

  @@index([contactRequestId])
  @@index([contactRequestId, type])
  @@index([status])
}

enum InvoiceStatus {
  PENDING_APPROVAL
  APPROVED
}

// A staff-proposed price for a ContactRequest with no catalog price
// (everything except a priced Umrah package, which prices itself
// automatically — see resolvePayment()). One per request (no revision
// history): staff editing the amount before the customer acts just updates
// this same row. Approving it is what actually starts the ContactRequest's
// AWAITING_TRANSFER bank-transfer flow — this table only ever gates that
// one transition, so it needs no PAID/CANCELLED states of its own.
model Invoice {
  id               String        @id @default(cuid())
  invoiceNumber    String        @unique
  contactRequestId String        @unique
  currency         String
  amount           Decimal       @db.Decimal(12, 2)
  status           InvoiceStatus @default(PENDING_APPROVAL)
  approvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  contactRequest ContactRequest @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
}

enum CarrierMode {
  AIR
  SEA
}

// Admin-managed catalog of airlines/ferry operators staff price a
// ContactRequestOffer's TripLeg against. Never hard-deleted (see `active`),
// so historical TripLeg rows always keep a valid reference.
model Carrier {
  id        String      @id @default(cuid())
  name      String
  mode      CarrierMode
  code      String?
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  legs TripLeg[]

  @@unique([name, mode])
  @@index([mode])
  @@index([active])
}

enum ContactRequestOfferStatus {
  PENDING_APPROVAL
  APPROVED
  DECLINED
  WITHDRAWN
}

// A staff-proposed priced alternative for a ContactRequest — generalizes
// Invoice to services where more than one priced option can legitimately
// exist for the same request, e.g. two airlines quoted for the same
// flight. Unlike Invoice, contactRequestId is NOT unique: many rows are
// expected per request. The customer picks exactly one (see
// approveContactRequestOffer in contact-requests.service.js); every other
// still-PENDING_APPROVAL sibling is auto-DECLINEd at that point.
model ContactRequestOffer {
  id               String                    @id @default(cuid())
  contactRequestId String
  currency         String
  amount           Decimal                   @db.Decimal(12, 2)
  status           ContactRequestOfferStatus @default(PENDING_APPROVAL)
  notes            String?
  approvedAt       DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  contactRequest ContactRequest @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
  legs           TripLeg[]

  @@index([contactRequestId])
  @@index([status])
}

enum TripLegDirection {
  OUTBOUND
  RETURN
}

// PROPOSED until staff has actually booked with the carrier (a manual,
// out-of-band action today), then BOOKED once reserved and TICKETED once
// the ticket/PNR is issued. Not driven by the parent offer's own status —
// an APPROVED offer's legs don't jump straight to BOOKED, since staff
// still has to actually go make the booking with the carrier.
enum TripLegTicketStatus {
  PROPOSED
  BOOKED
  TICKETED
  CANCELLED
}

// One flight/ferry segment within a ContactRequestOffer — a round-trip
// flight offer has two rows (OUTBOUND + RETURN), a one-way flight or a
// single ferry crossing has one. fromLocation/toLocation are free text,
// entered manually by staff for now. Kept structured (rather than folding
// leg details into ContactRequestOffer.notes) so a later automated
// booking-site fetch can populate these same fields without a schema
// change.
model TripLeg {
  id              String              @id @default(cuid())
  offerId         String
  carrierId       String
  direction       TripLegDirection    @default(OUTBOUND)
  tripNumber      String?
  departureAt     DateTime?
  arrivalAt       DateTime?
  fromLocation    String
  toLocation      String
  ticketStatus    TripLegTicketStatus @default(PROPOSED)
  ticketReference String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  offer   ContactRequestOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  carrier Carrier             @relation(fields: [carrierId], references: [id], onDelete: Restrict)

  @@index([offerId])
  @@index([carrierId])
}

// One-time WhatsApp login codes for the customer-facing request-tracking
// portal (see customer-auth module). Deliberately has no relation to User
// or Customer — its identity IS the phone number, which is what keeps a
// customer session token structurally distinct from a staff one (no `sub`
// to satisfy requireAuth's staff-shaped payload check).
model CustomerLoginCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
  @@index([expiresAt])
}

// What staff are actually *doing* with a ContactRequest once it's paid for —
// orthogonal to ContactRequestStatus (staff triage) and
// ContactRequestPaymentStatus (money). Values are a single shared enum, but
// which subset is legal for a given request is decided per-department at the
// application layer — see EXECUTION_STAGES_BY_DEPARTMENT in
// contact-request-execution.js. (A per-department enum would mean five
// nullable columns and five sets of query logic for one concept; Postgres
// enum values are scoped to their own type, so nothing here collides with
// e.g. OrderStatus.CANCELLED.)
enum ContactRequestExecutionStage {
  // Shared — legal for every department, including an unmapped (NULL)
  // department request.
  AWAITING_EXECUTION
  IN_PROGRESS

  // VISAS
  SUBMITTED_TO_AUTHORITY
  VISA_ISSUED
  VISA_REJECTED

  // FLIGHTS + FERRY. Deliberately plural: this is the roll-up for the whole
  // approved offer. TripLeg.ticketStatus (PROPOSED/BOOKED/TICKETED/
  // CANCELLED) stays the per-segment detail — currently written by nothing,
  // and this does not change that.
  TICKETS_BOOKED
  TICKETS_ISSUED

  // UMRAH
  UMRAH_DOCUMENTS_PREPARED
  UMRAH_PACKAGE_READY

  // HOTELS_PACKAGES
  BOOKING_CONFIRMED_WITH_SUPPLIER
  VOUCHER_ISSUED

  // Shared terminal — no transitions out of these (VISA_REJECTED above is
  // terminal too, but department-specific).
  DELIVERED_TO_CUSTOMER
  CANCELLED
}

// Audit trail for every ContactRequest.executionStage transition — mirrors
// OrderStatusHistory's shape, with one deliberate difference: oldStage is
// nullable because executionStage starts NULL (OrderStatusHistory.oldStatus
// is never null because Order.status is never null and createOrder seeds a
// NEW -> NEW row).
model ContactRequestExecutionHistory {
  id               String                        @id @default(cuid())
  contactRequestId String
  oldStage         ContactRequestExecutionStage?
  newStage         ContactRequestExecutionStage
  changedByUserId  String
  notes            String?
  changedAt        DateTime                      @default(now())

  contactRequest ContactRequest @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
  changedByUser  User           @relation("ExecutionStageChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([contactRequestId])
  @@index([changedByUserId])
}

// One-time WhatsApp codes for staff self-service password reset. Deliberately
// a separate table from CustomerLoginCode (which is keyed by phone and
// relation-free by design — see its comment): this one is keyed by userId,
// authorizes a password write rather than minting a session, and must never
// be verifiable through the customer-auth endpoints.
model StaffPasswordResetCode {
  id         String    @id @default(cuid())
  userId     String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation("StaffPasswordResets", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
