generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum OrderStatus {
  NEW
  UNDER_REVIEW
  WAITING_DOCUMENTS
  PAYMENT_PENDING
  PROCESSING
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum DocumentType {
  PASSPORT
  PHOTO
  VISA
  TICKET
  RECEIPT
  OTHER
}

enum OfferStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String   @unique
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  User[]
  orders Order[]
}

model CompanyProfile {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  logoUrl   String?
  phone     String?
  whatsapp  String?
  email     String?
  address   String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Currency {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  symbol    String
  rateToSAR Decimal  @db.Decimal(18, 6)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentAccount {
  id            String   @id @default(cuid())
  name          String
  bankName      String
  accountName   String
  accountNumber String?
  iban          String?
  currency      String
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([currency])
  @@index([active])
  @@index([sortOrder])
}

model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  type      String
  phone     String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String     @id @default(cuid())
  employeeNo   String     @unique
  fullName     String
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  role         UserRole   @default(EMPLOYEE)
  status       UserStatus @default(ACTIVE)
  branchId     String?
  lastLogin    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  branch                             Branch?                     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedOrders                     Order[]                     @relation("AssignedOrders")
  uploadedDocuments                  Document[]                  @relation("UploadedDocuments")
  notes                              Note[]
  activityLogs                       ActivityLog[]
  notifications                      Notification[]              @relation("UserNotifications")
  statusChangedLogs                  OrderStatusHistory[]        @relation("StatusChangedBy")
  invoicesCreated                    Invoice[]                   @relation("InvoiceCreatedBy")
  reviewedContactRequestDocuments    ContactRequestDocument[]    @relation("ContactRequestDocumentReviewedBy")
  contactRequestOffersCreated        ContactRequestOffer[]       @relation("ContactRequestOfferCreatedBy")
  contactRequestDeliverablesUploaded ContactRequestDeliverable[]  @relation("ContactRequestDeliverableUploadedBy")
