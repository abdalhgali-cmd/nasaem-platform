generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum OrderStatus {
  NEW
  UNDER_REVIEW
  WAITING_DOCUMENTS
  PAYMENT_PENDING
  PROCESSING
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum DocumentType {
  PASSPORT
  PHOTO
  VISA
  TICKET
  RECEIPT
  OTHER
}

enum OfferStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String   @unique
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  User[]
  orders Order[]
}

model CompanyProfile {
  id          String   @id @default(cuid())
  name        String
  legalName   String?
  logoUrl     String?
  phone       String?
  whatsapp    String?
  email       String?
  address     String?
  website     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Currency {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  symbol     String
  rateToSAR  Decimal  @db.Decimal(18, 6)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Supplier {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  type       String
  phone      String?
  email      String?
  notes      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id              String     @id @default(cuid())
  employeeNo      String     @unique
  fullName        String
  email           String     @unique
  phone           String?    @unique
  passwordHash    String
  role            UserRole   @default(EMPLOYEE)
  status          UserStatus @default(ACTIVE)
  branchId        String?
  lastLogin       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  branch              Branch?                @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedOrders      Order[]                @relation("AssignedOrders")
  uploadedDocuments   Document[]             @relation("UploadedDocuments")
  notes               Note[]
  activityLogs        ActivityLog[]
  notifications       Notification[]         @relation("UserNotifications")
  statusChangedLogs   OrderStatusHistory[]   @relation("StatusChangedBy")
  invoicesCreated     Invoice[]              @relation("InvoiceCreatedBy")
  reviewedContactRequestDocuments ContactRequestDocument[] @relation("ContactRequestDocumentReviewedBy")

  @@index([role])
  @@index([status])
  @@index([branchId])
}

model Customer {
  id            String    @id @default(cuid())
  customerNo    String    @unique
  fullName      String
  passportNo    String    @unique
  nationality   String
  birthDate     DateTime?
  gender        Gender?
  phone         String?
  email         String?
  country       String?
  city          String?
  address       String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders     Order[]
  documents  Document[]

  @@index([customerNo])
  @@index([passportNo])
  @@index([phone])
  @@index([email])
}

model Service {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  category    String
  description String?
  basePrice   Decimal     @db.Decimal(12, 2)
  currency    String      @default("SAR")
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  orderItems  OrderItem[]
  workflows   Workflow[]
  visaTypes   VisaType[]

  @@index([category])
  @@index([active])
}

model VisaType {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  country     String
  description String?
  basePrice   Decimal   @db.Decimal(12, 2)
  currency    String    @default("SAR")
  active      Boolean   @default(true)
  serviceId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([country])
  @@index([active])
}

model Workflow {
  id          String    @id @default(cuid())
  serviceId   String
  stepNo      Int
  title       String
  description String?
  required    Boolean   @default(true)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, stepNo])
  @@index([serviceId])
}

model Order {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  customerId      String
  assignedUserId  String?
  branchId        String?
  status          OrderStatus    @default(NEW)
  paymentStatus   PaymentStatus  @default(UNPAID)
  priority        String         @default("NORMAL")
  totalAmount     Decimal        @db.Decimal(12, 2)
  currency       String         @default("SAR")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedUser   User?                @relation("AssignedOrders", fields: [assignedUserId], references: [id], onDelete: SetNull)
  branch         Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  documents      Document[]
  payments       Payment[]
  notes          Note[]
  history        OrderStatusHistory[]
  notifications  Notification[]

  @@index([customerId])
  @@index([assignedUserId])
  @@index([branchId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id          String    @id @default(cuid())
  orderId     String
  serviceId   String
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(12, 2)
  discount    Decimal   @db.Decimal(12, 2) @default(0)
  total       Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([serviceId])
}

model Document {
  id            String       @id @default(cuid())
  orderId       String
  customerId    String
  uploadedById  String
  type          DocumentType
  fileName      String
  storagePath   String
  mimeType      String?
  sizeBytes     Int?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uploadedBy  User    @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([customerId])
  @@index([uploadedById])
  @@index([type])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("SAR")
  paymentMethod   String
  referenceNumber String?
  status          PaymentStatus @default(UNPAID)
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model Note {
  id         String    @id @default(cuid())
  orderId    String
  userId     String
  note       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([userId])
}

model OrderStatusHistory {
  id              String       @id @default(cuid())
  orderId         String
  oldStatus       OrderStatus
  newStatus       OrderStatus
  changedByUserId String
  notes           String?
  changedAt       DateTime     @default(now())

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User @relation("StatusChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([changedByUserId])
}

model Notification {
  id        String    @id @default(cuid())
  title     String
  message   String
  type      String
  userId    String?
  orderId   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User?  @relation("UserNotifications", fields: [userId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([type])
}

model Offer {
  id          String      @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  price       Decimal     @db.Decimal(12, 2)
  currency    String      @default("SAR")
  startDate   DateTime?
  endDate     DateTime?
  status      OfferStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
}

model ActivityLog {
  id         String    @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model Setting {
  id         String   @id @default(cuid())
  key        String   @unique
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Used to generate sequential human-readable numbers (order/customer/employee)
// via an atomic single-statement upsert, instead of count()-based generation
// which is subject to race conditions under concurrent requests.
model Counter {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// One row per known branding slot (see site-assets.constants.js for the
// fixed list of allowed keys) — the currently-live file for that slot.
// Uploading again replaces the row (and the old file on disk) rather than
// versioning, since only the current asset is ever served.
model SiteAsset {
  id          String   @id @default(cuid())
  key         String   @unique
  fileName    String
  storagePath String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ContactRequestStatus {
  NEW
  CONTACTED
  CLOSED
}

// Tracks the customer's side of a manual bank-transfer payment for a priced
// ContactRequest — there is no payment gateway integration, so this is a
// declared-then-verified flow: staff price it (Invoice), the customer
// approves, transfers the money out-of-band, and tells us; staff then
// confirms the transfer actually arrived.
enum ContactRequestPaymentStatus {
  NOT_REQUIRED
  AWAITING_TRANSFER
  UNDER_REVIEW
  CONFIRMED
}

// Submissions from the public marketing site's contact form (unauthenticated
// endpoint) — reviewed and actioned by staff, distinct from Customer/Order
// which represent an already-onboarded client with a real booking.
model ContactRequest {
  id        String               @id @default(cuid())
  name      String
  phone     String
  // Digits-only, country-code-normalized form of `phone` (see utils/phone.js)
  // — lets the /track flow match a request by phone regardless of how the
  // customer originally typed it (spaces, +, leading 0 vs 249, ...).
  phoneNormalized String          @default("")
  email     String?
  service   String?
  message   String
  status    ContactRequestStatus @default(NEW)
  paymentStatus      ContactRequestPaymentStatus @default(NOT_REQUIRED)
  paymentConfirmedAt DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  invoice   Invoice?
  documents ContactRequestDocument[]

  @@index([status])
  @@index([createdAt])
  @@index([phoneNormalized])
}

enum ContactRequestDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// A file the customer uploaded via /track for this request (e.g. a passport
// scan) and staff's review of it. Append-only by design — a re-upload after
// rejection creates a new row rather than overwriting the old one, so the
// review history stays intact; "the current one" is simply the most recent
// row per `label`. No fixed per-service checklist exists (services vary too
// widely — visas, flights, hotels, ...), so `label` is free text rather than
// an enum.
model ContactRequestDocument {
  id               String                        @id @default(cuid())
  contactRequestId String
  label            String
  fileName         String
  storagePath      String
  mimeType         String
  sizeBytes        Int
  status           ContactRequestDocumentStatus @default(PENDING)
  reviewNote       String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  contactRequest ContactRequest @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
  reviewedBy     User?          @relation("ContactRequestDocumentReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([contactRequestId])
  @@index([status])
  @@index([reviewedByUserId])
}

enum InvoiceStatus {
  PENDING
  APPROVED
  REJECTED
}

// A single formal price quote for a ContactRequest, issued by staff and
// requiring explicit customer approval (via /track) before any payment step
// is presented. One-to-one and mutable only pre-approval: once APPROVED, the
// price is locked — reissuing after a REJECTED decision is the only way to
// offer a revised price.
model Invoice {
  id               String        @id @default(cuid())
  contactRequestId String        @unique
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("SAR")
  description      String?
  status           InvoiceStatus @default(PENDING)
  createdByUserId  String
  decidedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  contactRequest ContactRequest @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
  createdBy      User           @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([createdByUserId])
}

// One-time WhatsApp verification codes for the public /track self-service
// login (POST /api/tracking/request-code, verify-code) — deliberately
// separate from User/Customer, since the person tracking a request may not
// exist as either yet (a ContactRequest is often someone's very first
// contact with the company, before they're ever onboarded as a Customer).
model ContactRequestLoginCode {
  id         String    @id @default(cuid())
  phone      String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone])
}
