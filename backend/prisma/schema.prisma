generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum OrderStatus {
  NEW
  UNDER_REVIEW
  WAITING_DOCUMENTS
  PAYMENT_PENDING
  PROCESSING
  APPROVED
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

// Optional review lifecycle for an individual Payment record, layered on top
// of the existing `status` field without changing its values (flight-booking
// payment confirmation and other existing writers keep working unchanged).
// Null means "recorded directly by staff, no review step used" — the
// pre-existing behavior. Only payments explicitly submitted for review carry
// PENDING/CONFIRMED/REJECTED.
enum PaymentReviewStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum DocumentType {
  PASSPORT
  PHOTO
  VISA
  TICKET
  RECEIPT
  OTHER
}

enum OfferStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String   @unique
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users  User[]
  orders Order[]
}

model CompanyProfile {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  logoUrl   String?
  phone     String?
  whatsapp  String?
  email     String?
  address   String?
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Currency {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  symbol    String
  rateToSAR Decimal  @db.Decimal(18, 6)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentAccount {
  id            String   @id @default(cuid())
  name          String
  bankName      String
  accountName   String
  accountNumber String?
  iban          String?
  currency      String
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([currency])
  @@index([active])
  @@index([sortOrder])
}

model Supplier {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  type      String
  phone     String?
  email     String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
}

model User {
  id           String     @id @default(cuid())
  employeeNo   String     @unique
  fullName     String
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  role         UserRole   @default(EMPLOYEE)
  status       UserStatus @default(ACTIVE)
  branchId     String?
  lastLogin    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  branch                             Branch?                     @relation(fields: [branchId], references: [id], onDelete: SetNull)
  assignedOrders                     Order[]                     @relation("AssignedOrders")
  uploadedDocuments                  Document[]                  @relation("UploadedDocuments")
  notes                              Note[]
  activityLogs                       ActivityLog[]
  notifications                      Notification[]              @relation("UserNotifications")
  statusChangedLogs                  OrderStatusHistory[]        @relation("StatusChangedBy")
  paymentsReviewed                   Payment[]                   @relation("PaymentReviewedBy")
  invoicesCreated                    Invoice[]                   @relation("InvoiceCreatedBy")
  reviewedContactRequestDocuments    ContactRequestDocument[]    @relation("ContactRequestDocumentReviewedBy")
  contactRequestOffersCreated        ContactRequestOffer[]       @relation("ContactRequestOfferCreatedBy")
  contactRequestDeliverablesUploaded ContactRequestDeliverable[] @relation("ContactRequestDeliverableUploadedBy")

  @@index([role])
  @@index([status])
  @@index([branchId])
}

model Customer {
  id          String    @id @default(cuid())
  customerNo  String    @unique
  fullName    String
  passportNo  String    @unique
  nationality String
  birthDate   DateTime?
  gender      Gender?
  phone       String?
  email       String?
  country     String?
  city        String?
  address     String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  orders           Order[]
  documents        Document[]
  umrahGroupMember UmrahGroupMember[]

  @@index([customerNo])
  @@index([passportNo])
  @@index([phone])
  @@index([email])
}

model Service {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  category    String
  description String?
  basePrice   Decimal  @db.Decimal(12, 2)
  currency    String   @default("SAR")
  active      Boolean  @default(true)
  // Platform 3.0 Phase 3 (Dynamic Service Catalog) — admin-configurable
  // display metadata. iconKey/imageKey mirror HomepageSection's pattern
  // exactly: iconKey is validated against the shared ICON_KEYS allow-list
  // at the API layer (utils/enums.js), imageKey is a derived SiteAsset key
  // (`service-image-<id>`) set only after a successful image upload.
  // features is a small array of short bullet strings, not a separate
  // table — nothing here needs its own identity, ordering or relations.
  sortOrder   Int      @default(0)
  iconKey     String?
  imageKey    String?
  features    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems      OrderItem[]
  workflows       Workflow[]
  visaTypes       VisaType[]
  contactRequests ContactRequest[]

  @@index([category])
  @@index([active])
  @@index([sortOrder])
}

model VisaType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  country     String
  description String?
  basePrice   Decimal  @db.Decimal(12, 2)
  currency    String   @default("SAR")
  active      Boolean  @default(true)
  serviceId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service         Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  contactRequests ContactRequest[]

  @@index([country])
  @@index([active])
}

model Workflow {
  id          String   @id @default(cuid())
  serviceId   String
  stepNo      Int
  title       String
  description String?
  required    Boolean  @default(true)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, stepNo])
  @@index([serviceId])
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  customerId     String
  assignedUserId String?
  branchId       String?
  status         OrderStatus   @default(NEW)
  paymentStatus  PaymentStatus @default(UNPAID)
  priority       String        @default("NORMAL")
  totalAmount    Decimal       @db.Decimal(12, 2)
  currency       String        @default("SAR")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  customer         Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  assignedUser     User?                @relation("AssignedOrders", fields: [assignedUserId], references: [id], onDelete: SetNull)
  branch           Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  documents        Document[]
  payments         Payment[]
  notes            Note[]
  history          OrderStatusHistory[]
  notifications    Notification[]
  umrahGroupMember UmrahGroupMember[]

  @@index([customerId])
  @@index([assignedUserId])
  @@index([branchId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  serviceId    String
  quantity     Int      @default(1)
  unitPrice    Decimal  @db.Decimal(12, 2)
  discount     Decimal  @default(0) @db.Decimal(12, 2)
  total        Decimal  @db.Decimal(12, 2)
  // Both nullable and independent of each other on purpose: cost is often
  // learned after the sale (a supplier invoice arrives later), so an item
  // can carry a supplierId without a cost yet, or vice versa. Financial
  // reporting only computes gross profit for items that have a cost set —
  // see finance.service.js's costCoverage/grossProfit "unavailable" rule.
  supplierId   String?
  supplierCost Decimal? @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([serviceId])
  @@index([supplierId])
}

model Document {
  id           String       @id @default(cuid())
  orderId      String
  customerId   String
  uploadedById String
  type         DocumentType
  fileName     String
  storagePath  String
  mimeType     String?
  sizeBytes    Int?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([customerId])
  @@index([uploadedById])
  @@index([type])
}

model Payment {
  id               String               @id @default(cuid())
  orderId          String
  amount           Decimal              @db.Decimal(12, 2)
  currency         String               @default("SAR")
  paymentMethod    String
  referenceNumber  String?
  status           PaymentStatus        @default(UNPAID)
  paidAt           DateTime?
  reviewStatus     PaymentReviewStatus?
  rejectionReason  String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("PaymentReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([reviewStatus])
}

model Note {
  id        String   @id @default(cuid())
  orderId   String
  userId    String
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([userId])
}

model OrderStatusHistory {
  id              String      @id @default(cuid())
  orderId         String
  oldStatus       OrderStatus
  newStatus       OrderStatus
  changedByUserId String
  notes           String?
  changedAt       DateTime    @default(now())

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User  @relation("StatusChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([changedByUserId])
}

model Notification {
  id        String    @id @default(cuid())
  title     String
  message   String
  type      String
  userId    String?
  orderId   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user  User?  @relation("UserNotifications", fields: [userId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([type])
}

model Offer {
  id          String      @id @default(cuid())
  title       String
  description String?
  imageUrl    String?
  price       Decimal     @db.Decimal(12, 2)
  currency    String      @default("SAR")
  startDate   DateTime?
  endDate     DateTime?
  status      OfferStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status])
}

// Admin-controlled homepage service cards (Platform 3.0 Phase 1). The hero
// itself (title/description/CTA/image) is deliberately NOT modeled here —
// it's a singleton, so it lives as Setting rows (HOMEPAGE_HERO_*) and a
// SiteAsset image slot ("hero-image"), reusing existing infrastructure
// instead of a table with exactly one meaningful row. This model is for the
// list of service cards, which genuinely need order + per-row visibility +
// per-row image, none of which Setting can express.
//
// iconKey/imageKey are validated against fixed allow-lists at the API layer
// (a known Lucide icon name; an existing SiteAsset key) rather than trusted
// as arbitrary strings, so a section can never reference an icon component
// or asset that doesn't exist.
model HomepageSection {
  id          String   @id @default(cuid())
  key         String   @unique
  title       String
  description String?
  href        String?
  iconKey     String?
  imageKey    String?
  visible     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([visible])
  @@index([sortOrder])
}

// A travel batch for a group Umrah trip. Deliberately thin: it holds the
// group-level logistics (name/date/airline/hotel/transport) and nothing
// else — every per-traveler fact (visa/ticket/payment/document readiness)
// is read live off that member's existing Customer/Order rows instead of
// being duplicated here, so a group is a view over Orders/Customers, not a
// parallel system (see UmrahGroupMember and umrah-groups.service.js).
model UmrahGroup {
  id         String    @id @default(cuid())
  code       String    @unique
  name       String
  travelDate DateTime?
  airline    String?
  hotel      String?
  transport  String?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  members UmrahGroupMember[]

  @@index([travelDate])
}

model UmrahGroupMember {
  id         String   @id @default(cuid())
  groupId    String
  customerId String
  // The Umrah order this member's readiness (payment/documents/visa/ticket)
  // is read from. Nullable: a customer can be added to a group before an
  // order exists for them yet — they simply show as not ready until linked.
  orderId    String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  group    UmrahGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  order    Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([groupId, customerId])
  @@index([groupId])
  @@index([customerId])
  @@index([orderId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Counter {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model SiteAsset {
  id          String   @id @default(cuid())
  key         String   @unique
  fileName    String
  storagePath String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ContactRequestStatus {
  NEW
  CONTACTED
  CLOSED
}

enum ContactRequestOutcome {
  COMPLETED
  REJECTED
  CANCELLED
}

enum ContactRequestPaymentStatus {
  NOT_REQUIRED
  AWAITING_TRANSFER
  UNDER_REVIEW
  CONFIRMED
}

model ContactRequest {
  id                 String                      @id @default(cuid())
  name               String
  phone              String
  phoneNormalized    String                      @default("")
  email              String?
  service            String?
  serviceId          String?
  visaTypeId         String?
  travelerCount      Int?
  intakeData         Json?
  message            String
  status             ContactRequestStatus        @default(NEW)
  outcome            ContactRequestOutcome?
  outcomeNote        String?
  closedAt           DateTime?
  paymentStatus      ContactRequestPaymentStatus @default(NOT_REQUIRED)
  paymentConfirmedAt DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  serviceRef      Service?                    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  visaType        VisaType?                   @relation(fields: [visaTypeId], references: [id], onDelete: SetNull)
  invoice         Invoice?
  documents       ContactRequestDocument[]
  deliverables    ContactRequestDeliverable[]
  offers          ContactRequestOffer[]       @relation("ContactRequestOffers")
  selectedOfferId String?                     @unique
  selectedOffer   ContactRequestOffer?        @relation("SelectedOffer", fields: [selectedOfferId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@index([phoneNormalized])
  @@index([serviceId])
  @@index([visaTypeId])
}

enum ContactRequestDocumentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model ContactRequestDocument {
  id               String                       @id @default(cuid())
  contactRequestId String
  label            String
  fileName         String
  storagePath      String
  mimeType         String
  sizeBytes        Int
  status           ContactRequestDocumentStatus @default(PENDING)
  reviewNote       String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  contactRequest ContactRequest @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
  reviewedBy     User?          @relation("ContactRequestDocumentReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([contactRequestId])
  @@index([status])
  @@index([reviewedByUserId])
}

model ContactRequestDeliverable {
  id               String   @id @default(cuid())
  contactRequestId String
  label            String
  fileName         String
  storagePath      String
  mimeType         String
  sizeBytes        Int
  uploadedByUserId String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contactRequest ContactRequest @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
  uploadedBy     User           @relation("ContactRequestDeliverableUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@index([contactRequestId])
  @@index([uploadedByUserId])
}

model ContactRequestOffer {
  id               String   @id @default(cuid())
  contactRequestId String
  carrier          String
  description      String?
  amount           Decimal  @db.Decimal(12, 2)
  currency         String   @default("SAR")
  createdByUserId  String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contactRequest ContactRequest  @relation("ContactRequestOffers", fields: [contactRequestId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("ContactRequestOfferCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  selectedFor    ContactRequest? @relation("SelectedOffer")

  @@index([contactRequestId])
  @@index([createdByUserId])
}

enum InvoiceStatus {
  PENDING
  APPROVED
  REJECTED
}

model Invoice {
  id               String        @id @default(cuid())
  contactRequestId String        @unique
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("SAR")
  description      String?
  status           InvoiceStatus @default(PENDING)
  createdByUserId  String
  decidedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  contactRequest ContactRequest @relation(fields: [contactRequestId], references: [id], onDelete: Cascade)
  createdBy      User           @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([status])
  @@index([createdByUserId])
}

model ContactRequestLoginCode {
  id         String    @id @default(cuid())
  phone      String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone])
}
