PORT=5000
NODE_ENV=development

# When running via `docker compose up` (see ../docker-compose.yml), the backend
# reaches Postgres through the Docker network using the service name "postgres".
# If you run the backend directly on your host machine instead (npm run dev
# outside Docker), change the host below to "localhost".
DATABASE_URL="postgresql://postgres:password@postgres:5432/nasaem_platform?schema=public"

JWT_SECRET="replace_with_a_long_random_secret"
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Root directory for all persisted uploads.
# Development may use the relative default `uploads`.
# Production requires an EXPLICIT ABSOLUTE path; the API fails closed otherwise.
# On Railway, mount a persistent volume and point this to its mount path,
# e.g. /data/uploads. Customer documents must not live on ephemeral disk.
UPLOAD_ROOT=uploads

SEED_ADMIN_PASSWORD="replace_with_a_strong_password"

# WhatsApp notifications (Meta WhatsApp Cloud API) — optional.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_NUMBER=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar
# Without WhatsApp configured (and the WHATSAPP flag on), tracking and
# password-reset codes are refused with 503 OTP_CHANNEL_UNAVAILABLE in
# production instead of pretending a code was sent.

# Organization that owns public (no-account) requests and the only one
# phone-OTP tracking can reach. Server-side only; defaults to the default org.
PUBLIC_ORGANIZATION_ID=

# Flight provider (Trip). Keep empty until the provider endpoint and token are available.
# The adapter expects POST JSON: { legs: [{ from, to, departureDate }], travelers }.
# It accepts a response shaped as an array, { data: [...] }, { results: [...] },
# or { legs: [...] } and normalizes common flight fields.
TRIP_API_URL=
TRIP_API_TOKEN=
