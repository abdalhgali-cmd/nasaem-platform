PORT=5000
NODE_ENV=development

# When running via `docker compose up` (see ../docker-compose.yml), the backend
# reaches Postgres through the Docker network using the service name "postgres".
# If you run the backend directly on your host machine instead (npm run dev
# outside Docker), change the host below to "localhost".
DATABASE_URL="postgresql://postgres:password@postgres:5432/nasaem_platform?schema=public"

JWT_SECRET="replace_with_a_long_random_secret"
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Required by `npm run prisma:seed` to create the first SUPER_ADMIN account.
# Change this after the first login.
SEED_ADMIN_PASSWORD="replace_with_a_strong_password"

# WhatsApp notifications (Meta WhatsApp Cloud API) — optional. Leave
# WHATSAPP_API_TOKEN unset to disable entirely (e.g. in dev/test); every
# WhatsApp send then silently no-ops instead of failing.
# Setup: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Destination number for new-contact-request alerts, in international format
# without "+" or spaces (e.g. 249911034372).
WHATSAPP_ADMIN_NUMBER=
# Meta only allows free-form text messages to a number that has messaged
# your WhatsApp Business number in the last 24 hours. Staff won't have done
# that, so in production set this to an approved message-template name
# (Meta Business Manager > Message Templates) — the alert text is then sent
# as that template's single body parameter instead of free-form text.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=ar
