{
  "name": "nasaem-mobile",
  "version": "0.3.0",
  "private": true,
  "description": "Nasaem Al-Haramain customer app (Android, Capacitor WebView over the existing backend API).",
  "scripts": {
    "android:add": "cap add android",
    "sync": "cap sync android",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "check": "node --check www/js/config.js && for f in www/js/*.js www/js/screens/*.js; do node --check \"$f\"; done",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "typescript": "^5.9.2"
  }
}
